<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OSDM.Core\OSDM.Core.csproj" />
  </ItemGroup>

  <!-- Ship the browser extension next to OSDM.exe, so users can "Load unpacked" from there. -->
  <ItemGroup>
    <None Include="..\browser-extension\**\*" LinkBase="browser-extension" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The same icon is the exe icon (Explorer, Start menu, Control Panel) and is loaded at run time for the window and tray. -->
  <ItemGroup>
    <EmbeddedResource Include="osdm.ico" LogicalName="osdm.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OSDM</AssemblyName>
    <Product>OSDM</Product>
    <Version>0.3.0</Version>
    <ApplicationIcon>osdm.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- dotnet publish -c Release  ->  one self-contained OSDM.exe -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
